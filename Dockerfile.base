FROM ghcr.io/carbynestack/spdz:642d11f_no-offline

# Switch to root to install dependencies
USER root

# Install system dependencies required for building Python packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-setuptools \
        python3-wheel \
        build-essential \
        cmake \
        g++ \
        libsodium-dev \
        libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy your Python requirements file
COPY requirements.txt /tmp/requirements.txt

# Install Python dependencies
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

COPY my-program.mpc /mp-spdz/Programs/Source/mpc-program.mpc

# Compile the MPC program to generate its schedule
WORKDIR /mp-spdz
RUN ./compile.py -F 64 Programs/Source/mpc-program.mpc

# Drop back to non-root user (as original image expects)
RUN useradd -m -u 1001 nonroot

# Drop privileges
USER nonroot